# Example only: Redis + 2 workers. Nothing here is applied by the repo; defaults stay single-process.
# Apply on the VM outside exam windows, after installing a local Redis (bind 127.0.0.1, protected-mode yes,
# save "", appendonly no, maxmemory 256mb, maxmemory-policy noeviction).
REDIS_URL=redis://127.0.0.1:6379/0
# remove FAIRPLAY_SINGLE_PROCESS (it is the single-process guard) when REDIS_URL is set
WEB_CONCURRENCY=2
# connections per worker: 2 x (5 + 5) = 20, far below Postgres max_connections
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
FAIRPLAY_DB_MAX_CONNECTIONS=90
FAIRPLAY_REPLICAS=1
# campus NAT addresses (higher per-address sign-in / homework-login limits)
FAIRPLAY_LOGIN_SCHOOL_NETS=203.0.113.0/24
# uvicorn: --host 127.0.0.1 --forwarded-allow-ips=127.0.0.1 --timeout-keep-alive 75 --no-access-log
