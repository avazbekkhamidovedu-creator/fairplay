@@ -0,0 +1,40 @@
+{% extends "base.html" %}
+
+{% block media %}
+<style>
+    .fp-launch { max-width: 680px; margin: 40px auto; padding: 0 20px; }
+    .fp-launch-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; margin: 24px 0; }
+    .fp-launch .fp-launch-button { display: inline-block; border: 1px solid #c9d1db; border-radius: 12px;
+        padding: 12px 18px; color: #243244; background: #f7f9fc; text-decoration: none; cursor: pointer; }
+    .fp-launch .fp-launch-primary { background: #2459a6; border-color: #2459a6; color: white; font-weight: 600; }
+    .fp-launch-downloads[open] { padding-bottom: 10px; }
+    .fp-launch-downloads a { display: block; margin: 12px 8px 0; }
+    .fp-launch-help { line-height: 1.6; }
+</style>
+{% endblock %}
+
+{% block body %}
+<main class="fp-launch">
+    <h2>{{ _('Open exam in FairPlay') }}</h2>
+    <p>{{ contest.name }}</p>
+    <p>{{ _('Use FairPlay to take this exam. Have the access code from your instructor ready.') }}</p>
+    <div class="fp-launch-actions">
+        <a class="fp-launch-button fp-launch-primary" href="{{ launch_url }}">{{ _('Start exam in FairPlay') }}</a>
+        <details class="fp-launch-downloads">
+            <summary class="fp-launch-button">{{ _('Download FairPlay') }}</summary>
+            <a href="https://github.com/avazbekkhamidovedu-creator/fairplay-download/releases/latest/download/FairPlay-Mac.dmg">{{ _('Mac download') }}</a>
+            <a href="https://github.com/avazbekkhamidovedu-creator/fairplay-download/releases/latest/download/FairPlay-Windows-Setup.exe">{{ _('Windows download') }}</a>
+        </details>
+        <a class="fp-launch-button" href="{{ launch_file_url }}">{{ _('Download launch file') }}</a>
+    </div>
+    <div class="fp-launch-help">
+        <ol>
+            <li>{{ _('Install the Mac or Windows app if needed, then choose Start exam in FairPlay.') }}</li>
+            <li>{{ _('Allow your browser to open FairPlay, then enter your instructor’s access code in the app.') }}</li>
+            <li>{{ _('If the browser cannot open it, download the launch file and open that with FairPlay.') }}</li>
+        </ol>
+        <p>{{ _('Using FairPlay 0.7.8 or an older app? Open FairPlay manually and enter your access code. Launch links and files require an updated app.') }}</p>
+        <p>{{ _('Opening the app does not start the exam or lock your computer. Follow the checks and start instructions inside FairPlay.') }}</p>
+    </div>
+</main>
+{% endblock %}
